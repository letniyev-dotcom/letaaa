<?xml version="1.0" encoding="utf-8"?>
<!--
    "Coral Sunset" background: soft, light, blurred pastel glow behind the
    gradient logo (ic_launcher_foreground). Built from overlapping radial
    gradients (fading to transparent) on a near-white base, approximating a
    blurred colour wash since VectorDrawable has no real blur filter.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- base -->
    <path android:pathData="M0,0h108v108h-108z" android:fillColor="#FFFDFB" />

    <!-- soft coral pool, top-left -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="24"
                android:centerY="22"
                android:gradientRadius="58">
                <item android:offset="0.0" android:color="#DEFFD2C9" />
                <item android:offset="0.55" android:color="#66FFD2C9" />
                <item android:offset="1.0" android:color="#00FFD2C9" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- soft amber pool, top-right -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="87"
                android:centerY="17"
                android:gradientRadius="54">
                <item android:offset="0.0" android:color="#D6FFE9C2" />
                <item android:offset="0.55" android:color="#5CFFE9C2" />
                <item android:offset="1.0" android:color="#00FFE9C2" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- soft pink pool, bottom-right -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="82"
                android:centerY="93"
                android:gradientRadius="60">
                <item android:offset="0.0" android:color="#DCFFC9DE" />
                <item android:offset="0.55" android:color="#5CFFC9DE" />
                <item android:offset="1.0" android:color="#00FFC9DE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- soft peach pool, bottom-left -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="16"
                android:centerY="92"
                android:gradientRadius="60">
                <item android:offset="0.0" android:color="#E0FFF3E0" />
                <item android:offset="0.6" android:color="#5CFFF3E0" />
                <item android:offset="1.0" android:color="#00FFF3E0" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
